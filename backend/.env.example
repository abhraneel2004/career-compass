# Copy to .env and fill in
# Gemini API key (free tier): aistudio.google.com > Get API key
GEMINI_API_KEY=

# Optional: Gemini model to use. Defaults to gemini-3.8-flash, the newest free-tier model
# GEMINI_MODEL=gemini-3.8-flash

# Port the server listens on locally; hosts like Render set this themselves
PORT=8080

# Firebase service account, so the server can check sign-ins and save career reports.
# Firebase console > Project settings > Service accounts > Generate new private key,
# then paste the whole JSON file onto one line. Without it, /api/career-suggestions returns 503.
FIREBASE_SERVICE_ACCOUNT=
