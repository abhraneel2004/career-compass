rules_version = '2';

// Career Compass Firestore rules
// Every document is keyed by the user's uid, and only that user can read or write it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Account: { email, createdAt, isPremium, resume }
    // Written by sign-up (AuthPage), the resume builder (lib/resume.js) and Pricing.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // A new account can't start out as premium
      allow create: if isOwner(uid)
        && (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);

      // NOTE: Pricing.jsx "pays" by setting isPremium from the browser, so it has to stay writable here.
      // Once real payments set it from a server, add:
      //   && request.resource.data.isPremium == resource.data.get('isPremium', false)
      allow update: if isOwner(uid);

      allow delete: if false;
    }

    // Quiz answers saved as you go (lib/quizProgress.js), cleared when the quiz is submitted
    match /quizProgress/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Career reports: { reports: [...], lastReportAt, generatingUntil? }
    // Only the backend writes these (backend/reportStore.js, with the Admin SDK, which skips
    // these rules). It checks the 30-day limit before calling Gemini, so browsers only read.
    match /pdfResults/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
